    "%@: %@" : {
      "comment" : "A label displaying the time when the app last fetched and processed water storage data from the dam. The argument is a formatted date and time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A label displaying a value on a chart. The value is a percentage of the maximum volume.",
