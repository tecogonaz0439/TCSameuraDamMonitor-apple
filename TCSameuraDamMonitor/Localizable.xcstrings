    "dialog.initialAutoUpdate.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, observation data is automatically fetched once a week (early Monday morning). The auto-update interval and timing can be changed in settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは、1週間に1回(月曜の未明〜明け方)自動的に観測データを取得します。自動更新の間隔やタイミングは設定より変更可能です。"
          }
        }
      }
    },
